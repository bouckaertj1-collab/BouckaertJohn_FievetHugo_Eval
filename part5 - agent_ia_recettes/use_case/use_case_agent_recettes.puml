@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Utilisateur" as User
actor "Stockage local
des recettes (JSON)" as Storage

rectangle "Agent IA Assistant de Recettes" {
  usecase "Enregistrer une
nouvelle recette" as UC1
  usecase "Afficher les recettes
disponibles" as UC2
  usecase "Trouver des recettes
avec un ingrédient donné" as UC3
  usecase "Proposer une recette
selon les ingrédients disponibles" as UC4
  usecase "Préparer une liste
d'achats" as UC5
  usecase "Supprimer une recette" as UC6
  usecase "Refuser une demande
hors périmètre" as UC7

  usecase "Lire les recettes" as UC8
  usecase "Modifier les recettes" as UC9
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

UC1 .> UC9 : <<include>>
UC6 .> UC9 : <<include>>
UC2 .> UC8 : <<include>>
UC3 .> UC8 : <<include>>
UC4 .> UC8 : <<include>>
UC5 .> UC8 : <<include>>

Storage --> UC8
Storage --> UC9
@enduml
